{
  "name": "pukaar",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "mobile:build:apk": "npm --prefix apps/mobile run build:apk"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "prettier": "3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
